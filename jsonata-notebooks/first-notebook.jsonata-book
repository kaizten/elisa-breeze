[{"kind":2,"language":"jsonata","value":"$loadFile(\"/data/example.json\")","outputs":[{"mime":"text/x-json","value":{"employees":[{"name":"John","age":30,"department":"Sales"},{"name":"Jane","age":25,"department":"Marketing"},{"name":"Doe","age":40,"department":"Development"}]}}]},{"kind":2,"language":"jsonata","value":"employees[1]","outputs":[{"mime":"text/x-json","value":{"name":"Jane","age":25,"department":"Marketing"}}]},{"kind":2,"language":"jsonata","value":"$count(employees)","outputs":[{"mime":"text/x-json","value":3}]},{"kind":2,"language":"jsonata","value":"employees[1].name & ' is ' & employees[1].age & ' years old'","outputs":[{"mime":"text/x-json","value":"Jane is 25 years old"}]},{"kind":2,"language":"jsonata","value":"$sum(employees.age)","outputs":[{"mime":"text/x-json","value":95}]}]