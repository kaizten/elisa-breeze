 $result;\n\n        $trim($result);\n    )};\n\n    $map($, function($v, $i, $a) {\n        {\n            \"a\": $humanize($v.a),\n            \"b\": $humanize($v.b),\n            \"c\": $humanize($v.c),\n            \"d\": $humanize($v.d)\n        }\n    })\n)\n","outputs":[{"mime":"text/x-json","value":{"a":"","b":"","c":"","d":""}}]}]