ees[].{\n    \"Empleado\": $.code,\n    \"Tiempo Descanso\": $sum([$number($match($.indicators.breakTime, /(\\d+)H/)[0].groups[0]) * 60, $number($match($.indicators.breakTime, /(\\d+)M/)[0].groups[0])])\n}","outputs":[{"mime":"text/x-json","value":[{"Empleado":"0000","Tiempo Descanso":240},{"Empleado":"0001","Tiempo Descanso":200},{"Empleado":"0002","Tiempo Descanso":240},{"Empleado":"0003","Tiempo Descanso":150},{"Empleado":"0004","Tiempo Descanso":90},{"Empleado":"0005","Tiempo Descanso":210},{"Empleado":"0006","Tiempo Descanso":210},{"Empleado":"0007","Tiempo Descanso":420},{"Empleado":"0008","Tiempo Descanso":420},{"Empleado":"0009","Tiempo Descanso":420},{"Empleado":"0010","Tiempo Descanso":390},{"Empleado":"0011","Tiempo Descanso":450},{"Empleado":"0012","Tiempo Descanso":450}]}]},{"kind":2,"language":"jsonata","value":"(\n$humanize := function($x) {(\n\n        $matches := $match($x, /(-)?P(?:([.,\\d]+)Y)?(?:([.,\\d]+)M)?(?:([.,\\d]+)W)?(?:([.,\\d]+)D)?T(?:([.,\\d]+)H)?(?:([.,\\d]+)M)?(?:([.,\\d]+)S)?/);\n        $result := \"\";\n        $days := $matches.groups[4];\n        $hours := $matches.groups[5];\n        $minutes := $matches.groups[6];\n        $seconds := $matches.groups[7];\n\n        $result := $days != null ? $days & \" day\" : \"\";\n        $result := $hours != null ? $result & \" \" & $hours & \" h\" : \"\";\n        $result := $minutes != null ? $result & \" \" & $minutes & \" min\" : $result;\n        $result := $seconds != null ? $result & \" \" & $seconds & \" sec\" : $result;\n\n        $result := $days = \"10675199\" ? \"unbounded\" : $result;\n\n        $trim($result);\n    )};\n\n    $map($, function($v, $i, $a) {\n        {\n            \"a\": $humanize($v.a),\n            \"b\": $humanize($v.b),\n            \"c\": $humanize($v.c),\n            \"d\": $humanize($v.d)\n        }\n    })\n)\n","outputs":[{"mime":"text/x-json","value":{"a":"","b":"","c":"","d":""}}]},{"kind":2,"language":"jsonata","value":"$loadFile(\"/data/convertedInstance-01.json\")","outputs":[{"mime":"text/x-json","value":{"services":[{"finishTime":"2024-01-15T20:41:48Z","code":"r-0000","role":"MANAGER","startTime":"2024-01-15T19:10:48Z","employees":1,"serviceTime":"PT1H31M"},{"finishTime":"2024-01-16T21:35:17Z","code":"r-0002","role":"MANAGER","startTime":"2024-01-16T20:18:17Z","employees":10,"serviceTime":"PT1H17M"},{"finishTime":"2024-01-16T21:45:28Z","code":"r-0004","role":"RAMP_MANAGER","startTime":"2024-01-16T20:58:28Z","employees":8,"serviceTime":"PT47M"},{"finishTime":"2024-01-19T08:17:53Z","code":"r-0003","role":"RAMP_MANAGER","startTime":"2024-01-19T06:31:53Z","employees":6,"serviceTime":"PT1H46M"},{"finishTime":"2024-01-19T11:08:37Z","code":"r-0001","role":"AGENT","startTime":"2024-01-19T10:04:37Z","employees":10,"serviceTime":"PT1H4M"},{"finishTime":"2024-01-15T08:00:00Z","code":"f-0005","role":"DRIVER","startTime":"2024-01-15T00:00:00Z","employees":1,"serviceTime":"PT8H"},{"finishTime":"2024-01-15T08:00:00Z","code":"f-0006","role":"MANAGER","startTime":"2024-01-15T00:00:00Z","employees":1,"serviceTime":"PT8H"},{"finishTime":"2024-01-15T08:00:00Z","code":"f-0007","role":"RAMP_MANAGER","startTime":"2024-01-15T00:00:00Z","employees":1,"serviceTime":"PT8H"},{"finishTime":"2024-01-15T08:00:00Z","code":"f-0008","role":"AGENT","startTime":"2024-01-15T00:00:00Z","employees":1,"serviceTime":"PT8H"},{"finishTime":"2024-01-15T16:00:00Z","code":"f-0009","role":"DRIVER","startTime":"2024-01-15T08:00:00Z","employees":1,"serviceTime":"PT8H"},{"finishTime":"2024-01-15T16:00:00Z","code":"f-0010","role":"MANAGER","startTime":"2024-01-15T08:00:00Z","employees":1,"serviceTime":"PT8H"},{"finishTime":"2024-01-15T16:00:00Z","code":"f-0011","role":"RAMP_MANAGER","startTime":"2024-01-15T08:00:00Z","employees":1,"serviceTime":"PT8H"},{"finishTime":"2024-01-15T16:00:00Z","code":"f-0012","role":"AGENT","startTime":"2024-01-15T08:00:00Z","employees":1,"serviceTime":"PT8H"},{"finishTime":"2024-01-16T00:00:00Z","code":"f-0013","role":"DRIVER"